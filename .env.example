# Local API (SQLite when DATABASE_URL is blank)
PORT=4000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
DORMDISH_DB_PATH=
DATABASE_URL=
PGSSLMODE=
PGPOOL_MAX=10

# Website build-time API URL. Leave blank for Vite proxy/local dev.
VITE_API_URL=

# Optional: Cloudinary image uploads. Required only when photo uploads are enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local sample accounts (for local SQLite classroom use only).
DEMO_SUPERADMIN_PASSWORD=LocalAdmin123!
DEMO_MANAGER_PASSWORD=LocalManager123!
DEMO_CUSTOMER_PASSWORD=LocalCustomer123!
DEMO_RIDER_PASSWORD=LocalRider123!

# Hosted Neon initialization: set INITIAL_ADMIN_* on Render, not in source control.
INITIAL_ADMIN_NAME=DormDish Administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=false
CORS_ORIGIN=
