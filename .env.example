PORT=4000
JWT_SECRET=replace-this-with-a-random-secret-at-least-24-characters
DORMDISH_DB_PATH=
VITE_API_URL=
DEMO_SUPERADMIN_PASSWORD=Admin123!
DEMO_MANAGER_PASSWORD=Manager123!
DEMO_CUSTOMER_PASSWORD=Customer123!
DEMO_RIDER_PASSWORD=Rider123!

# Demo accounts
SEED_DEMO_ACCOUNTS=false
SEED_SAMPLE_DATA=false
DEMO_SUPERADMIN_EMAIL=superadmin@dormdish.test
DEMO_MANAGER_ALPHA_EMAIL=manager.alpha@dormdish.test
DEMO_MANAGER_BETA_EMAIL=manager.beta@dormdish.test
DEMO_MANAGER_GAMMA_EMAIL=manager.gamma@dormdish.test
DEMO_CUSTOMER_EMAIL=customer@dormdish.test
DEMO_RIDER_EMAIL=rider@dormdish.test

# URLs
PUBLIC_WEB_URL=
PUBLIC_API_URL=
CORS_ORIGIN=

# Email delivery
# Recommended for Render Free: HTTPS API (does not use blocked SMTP ports)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Test only without a domain: Resend permits sending only to the email address on your Resend account.
# For production recipient addresses, verify a domain in Resend.
EMAIL_FROM=DormDish Delivery <onboarding@resend.dev>
SUPPORT_EMAIL=dormdishdelivery@gmail.com
SMTP_TEST_TO=your-resend-account-email@example.com

# Alternative: SMTP (use EMAIL_PROVIDER=smtp; Render Free blocks these ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=dormdishdelivery@gmail.com
SMTP_PASS=
SMTP_FROM=DormDish Delivery <dormdishdelivery@gmail.com>
