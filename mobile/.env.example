# Set this to the public Render API URL for remote testing and production builds.
# Example: https://dormdish-api.onrender.com/api
EXPO_PUBLIC_API_URL=https://YOUR-RENDER-API.onrender.com/api

# Website URL is used to load the existing public/images/* assets in the native app.
# Local Android emulator: http://10.0.2.2:5173
# Production: https://YOUR-RENDER-WEBSITE.onrender.com
EXPO_PUBLIC_WEBSITE_URL=https://YOUR-RENDER-WEBSITE.onrender.com
