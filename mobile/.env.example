# Expo loads the same Vite website used by the browser and Capacitor Android app.
# This keeps UI, navigation, login, and workflows in sync across platforms.
EXPO_PUBLIC_WEBSITE_URL=https://dormdishmobile-static.onrender.com

# For local phone testing, replace the line above with your PC's LAN URL, e.g.:
# EXPO_PUBLIC_WEBSITE_URL=http://192.168.1.20:5173
# Keep the PC and phone on the same network. The Vite /api proxy forwards to the local backend.
