{
    "name": "dormdish-mobile",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.js",
        "dev:web": "concurrently -k \"npm:server\" \"npm:dev:frontend\"",
        "dev:frontend": "vite --host 0.0.0.0 --port 5173 --strictPort",
        "dev:android": "vite build && cap run android --config capacitor.config.dev.json",
        "dev:full": "npm run dev:web",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0",
        "server": "node server/index.js",
        "db:reset": "node scripts/reset-database.js",
        "test": "node --test tests/*.test.js",
        "migrate:neon": "node scripts/migrate-sqlite-to-neon.js"
    },
    "dependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/core": "^6.2.1",
        "@vitejs/plugin-react": "^4.3.4",
        "bcryptjs": "^2.4.3",
        "better-sqlite3": "^13.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.468.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "vite": "^6.0.7",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.2.1",
        "concurrently": "^9.1.0"
    },
    "engines": {
        "node": ">=22.0.0"
    }
}
